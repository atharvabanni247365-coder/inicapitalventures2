# ==============================================================================
# MASTER ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to .env.local for local development, and configure these keys in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SANITY HEADLESS CMS CONFIGURATION
# ------------------------------------------------------------------------------
# Get your Project ID at https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here

# Default production dataset name
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API versioning string
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-26


# ------------------------------------------------------------------------------
# 2. RESEND EMAIL SERVICE CONFIGURATION (FOR CONTACT FORM)
# ------------------------------------------------------------------------------
# Get your API key at https://resend.com/api-keys after creating a free account.
RESEND_API_KEY=re_your_actual_resend_api_key_here

# The email address that receives incoming contact form submissions from website visitors
CONTACT_NOTIFICATION_EMAIL=your_email@example.com


# ------------------------------------------------------------------------------
# 3. SITE URL & SEO METADATA CONFIGURATION
# ------------------------------------------------------------------------------
# Your live production domain name (used for sitemap.xml, robots.txt, and OG image URLs)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
